<!DOCTYPE html>
<html>
  <head>
    <title>Last Year Single | Community & Connection</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Last Year Single is a thoughtful community for friendship, dating, and meaningful connection.">
    <meta name="theme-color" content="#ffffff">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'lys_enhancements', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'lys_messages', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
